<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- поворот по датчику, как на Android (ScreenOrientation.FullUser) -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<!-- API пока работает по http на IP-адресе; исключения ATS для IP не работают, поэтому разрешён весь http.
	     С переходом на https://psypath.cloud.nstu.ru блок можно убрать (как usesCleartextTraffic на Android) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- «Сохранить изображение» в окне «Поделиться» карточкой урока; без этой строки iOS закрывает приложение -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Психея сохранит карточку с результатом урока в «Фото».</string>
	<!-- только HTTPS: при загрузке в App Store Connect не спросят про шифрование -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Visual Studio 2022 собирает максимум .NET 9; для Visual Studio 2026 можно поставить net10.0-android -->
    <TargetFrameworks>net9.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PsyPath</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>Психея</ApplicationTitle>
    <ApplicationId>com.psypath.app</ApplicationId>
    <ApplicationDisplayVersion>1.3</ApplicationDisplayVersion>
    <ApplicationVersion>4</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS8618;CS8603;CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Иконка и заставка -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#F2E9D8" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#F2E9D8" BaseSize="160,160" />

    <!-- Маскот (манул без фона) -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Шрифты -->
    <MauiFont Include="Resources\Fonts\*.ttf" />

    <!-- JSON с уроками, тестом и справочником -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

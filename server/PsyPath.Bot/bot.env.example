# скопируй в bot.env и впиши значения; bot.env не выкладывать на GitHub

# токен от @BotFather
BOT_TOKEN=

# API Психеи. На сервере в Docker: http://psypath_api:5080, на ПК: http://217.71.129.139:6354
PSYPATH_API_URL=http://217.71.129.139:6354

# прокси до api.telegram.org, если он закрыт (так на сервере НГТУ): http://host:port или socks5://host:port
BOT_PROXY=

# свой адрес вместо https://api.telegram.org, например Cloudflare Worker (см. README); MTProto-прокси сюда не подходят
BOT_API_URL=

# часовой пояс для серии дней и цели дня
BOT_TZ=Asia/Novosibirsk

# папка, где бот хранит входы пользователей
BOT_DATA=data
